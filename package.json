{
  "name": "project-layman",
  "version": "1.0.0",
  "description": "A CLI harness that guides GitHub contributions with short, clear instructions.",
  "author": "saiyameh",
  "license": "MIT",
  "homepage": "https://github.com/saiyameh/project-layman#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/saiyameh/project-layman.git"
  },
  "bugs": {
    "url": "https://github.com/saiyameh/project-layman/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "layman": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "doctor": "tsx src/index.ts --doctor",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@clack/prompts": "^0.9.1",
    "@octokit/rest": "^21.1.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "execa": "^9.5.2",
    "madge": "^8.0.0",
    "openai": "^4.82.0",
    "p-limit": "^6.2.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "github",
    "search",
    "cli",
    "caveman",
    "fork",
    "clone",
    "contribute",
    "open-source",
    "developer-tools",
    "github-cli"
  ]
}
